# Copy to .env.local and adjust.

# Where the Spring Boot API lives in a PRODUCTION build.
# Leave empty in development: Vite proxies /api to the target below instead, so the
# browser makes same-origin requests and CORS never enters the picture.
VITE_API_BASE_URL=

# Dev-only: the backend the Vite proxy forwards /api to.
VITE_DEV_API_TARGET=http://localhost:8080
