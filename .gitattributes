# The backend builds inside a Linux container and the frontend is served to browsers,
# so everything is stored with LF regardless of who commits from Windows.
* text=auto eol=lf

# Never let Git touch these.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated — keep it out of diffs.
package-lock.json linguist-generated=true -diff
